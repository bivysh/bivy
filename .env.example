# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# .env holds live secrets for the control plane / relay / model providers.
# If any of these ever land in git history, treat them as compromised and
# rotate immediately (see docs/SECURITY.md).

# --- Model provider (node) ---------------------------------------------
# Used by the agent for model billing. Rotate from the provider console.
ANTHROPIC_API_KEY=

# Daemon-side watchdog for every agent turn (milliseconds). Defaults to one hour,
# caps at 24 hours, and marks timed-out work as failed so ephemeral runners and
# queues cannot remain pinned forever. Set 0 only for a trusted specialist node.
BIVY_TURN_TIMEOUT_MS=3600000

# --- Voice input (speech-to-text) --------------------------------------
# Optional. Keys are normally stored per-node via the app (Settings → Voice
# input) or the CLI ('bivy voice key groq'|'openai'); these env vars are a
# fallback when no stored key exists. Pick the preferred provider in the app
# or with 'bivy voice provider <groq|openai>'.
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Linear work queue (node, optional) --------------------------------
# Personal API key used only by the node to fetch claimed issue content.
BIVY_LINEAR_API_KEY=
# Default GitHub repository for Linear issues (owner/repo). Can be overridden
# per issue with a Linear label named repo:owner/repo.
BIVY_LINEAR_REPO=

# --- Relay <-> control-plane shared secret ------------------------------
# Long random string. The relay uses it to introspect tokens against the
# control plane. Generate with: openssl rand -hex 32
RELAY_SECRET=

# The PUBLIC wss URL of the relay (what phones connect to).
RELAY_PUBLIC_URL=wss://relay.bivy.sh

# --- Control-plane database --------------------------------------------
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Stripe (billing) ---------------------------------------------------
# Use TEST keys for development. Never commit live (sk_live_…) keys.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Transactional email (Resend) --------------------------------------
RESEND_API_KEY=
AUTH_EMAIL_FROM=Bivy <login@bivy.sh>
