    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
