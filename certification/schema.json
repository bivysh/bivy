{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bivy.sh/schemas/agent-certification-v1.json",
  "title": "Bivy supported-agent certification matrix",
  "type": "object",
  "required": ["schemaVersion", "requiredScenarios", "agents"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requiredScenarios": { "type": "array", "minItems": 12, "uniqueItems": true, "items": { "type": "string" } },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "status", "upstream", "platforms", "executionMode", "probe", "install", "auth", "capabilities"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["active", "suspended"] },
          "upstream": {
            "type": "object", "additionalProperties": false,
            "required": ["package", "pinnedVersion", "supportedRange"],
            "properties": {
              "package": { "type": "string", "minLength": 1 },
              "pinnedVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
              "supportedRange": { "type": "string", "minLength": 1 }
            }
          },
          "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["linux-x64", "linux-arm64", "darwin-x64", "darwin-arm64"] } },
          "executionMode": { "enum": ["protocol", "structured-pipe", "pipe", "pty"] },
          "probe": { "$ref": "#/$defs/command" },
          "install": { "$ref": "#/$defs/command" },
          "auth": {
            "type": "object", "additionalProperties": false, "required": ["owner", "allowedEnvironment"],
            "properties": {
              "owner": { "enum": ["bivy", "agent", "mixed"] },
              "allowedEnvironment": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
            }
          },
          "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object", "additionalProperties": false, "required": ["command", "args"],
      "properties": { "command": { "type": "string", "minLength": 1 }, "args": { "type": "array", "items": { "type": "string" } } }
    }
  }
}
