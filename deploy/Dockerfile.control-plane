# Build context is the repo root (see deploy/docker-compose.yml).

# Stage 1 — build the React PWA (@bivy/web) from the monorepo. --ignore-scripts
# skips native builds (e.g. node-pty) we don't need just to bundle the client.
FROM node:22-slim AS webbuild
WORKDIR /repo
# Ephemeral-machines UI flag, baked into the web bundle at build time (Vite reads
# VITE_*-prefixed env; see packages/web/src/flags.ts). OFF by default: pass
# --build-arg VITE_EPHEMERAL_MACHINES_ENABLED=1 to expose the surface (staging
# does; production omits it). Pairs with the runtime EPHEMERAL_MACHINES_ENABLED
# the control-plane service reads for server-side enforcement.
ARG VITE_EPHEMERAL_MACHINES_ENABLED
ENV VITE_EPHEMERAL_MACHINES_ENABLED=$VITE_EPHEMERAL_MACHINES_ENABLED
# The monorepo root installs with pnpm; corepack ships with the node image and
# resolves the version pinned in package.json's `packageManager`.
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ ./packages/
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm --filter @bivy/web run build

# Stage 2 — the control plane service.
FROM node:22-slim
WORKDIR /app
# The control plane imports @bivy/core (a monorepo sibling), declared as a
# `file:../../packages/core` dependency and loaded from source by tsx at runtime.
# Copy it in BEFORE install so that path resolves: from /app the `../../packages`
# prefix clamps at the container root, so core must live at /packages/core.
COPY packages/core /packages/core
COPY services/control-plane/package.json ./
RUN npm install
COPY services/control-plane/ ./
COPY deploy/healthcheck.sh /usr/local/bin/bivy-healthcheck
# Bundle the built React client so the control plane serves it at the root.
COPY --from=webbuild /repo/packages/web/dist ./public/react
# Pin V8's old-space ceiling below the container's docker-compose mem_limit
# (512m — see deploy/docker-compose.yml) instead of relying on Node's cgroup
# auto-detection, which isn't guaranteed across every Docker/cgroup version and
# only bounds the V8 heap anyway (RSS also carries connection buffers, the pg
# client, the Stripe SDK, etc. outside it). Left unpinned, growth can walk right
# up to the cgroup limit with no headroom for that non-heap RSS — and because
# docker-compose doesn't cap container swap either, the container doesn't get a
# fast OOM-kill + clean restart at that point, it drags the *host* into swap.
# 384m leaves ~128m of headroom under the 512m cap. If mem_limit changes, update
# this too.
ENV NODE_OPTIONS="--max-old-space-size=384"
EXPOSE 4400
CMD ["npm", "start"]
