# Build context is the repo root (see deploy/docker-compose.yml).

# Stage 1 — build the React PWA (@bivy/web) from the monorepo. --ignore-scripts
# skips native builds (e.g. node-pty) we don't need just to bundle the client.
FROM node:22-slim AS webbuild
WORKDIR /repo
# The monorepo root installs with pnpm; corepack ships with the node image and
# resolves the version pinned in package.json's `packageManager`.
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# Dependency installation depends on manifests, not workspace source. Keeping
# source out of this layer lets BuildKit reuse the expensive pnpm install when a
# normal web/core code change is deployed.
COPY packages/core/package.json ./packages/core/package.json
COPY packages/automation-core/package.json ./packages/automation-core/package.json
COPY packages/plugin-sdk/package.json ./packages/plugin-sdk/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/web/package.json ./packages/web/package.json
RUN pnpm install --filter @bivy/web... --frozen-lockfile --ignore-scripts
COPY packages/ ./packages/
# Ephemeral-machines UI flag, baked into the web bundle at build time (Vite reads
# VITE_*-prefixed env; see packages/web/src/flags.ts). Declare it only after the
# dependency layer so staging's value and production's default share that cache.
# Pass 1 to expose the surface (staging does; production omits it). Pairs with
# the runtime EPHEMERAL_MACHINES_ENABLED server-side enforcement flag.
ARG VITE_EPHEMERAL_MACHINES_ENABLED
ENV VITE_EPHEMERAL_MACHINES_ENABLED=$VITE_EPHEMERAL_MACHINES_ENABLED
RUN pnpm --filter @bivy/web run build

# Stage 2 — the control plane service.
FROM node:22-slim
# npm's prestart rebuild writes generated files under /repo, so give the
# unprivileged runtime user ownership before installing or copying source.
RUN mkdir -p /repo && chown node:node /repo
USER node
# Preserve the monorepo layout so the control-plane lockfile's
# `file:../../packages/*` links resolve exactly as they did when it was created.
WORKDIR /repo/services/control-plane
# automation-core compiles canonical files under /repo/src with NodeNext
# semantics; the root module marker ensures TypeScript emits ESM for them.
COPY --chown=node:node package.json /repo/package.json
# Linked package manifests are required while npm validates the lockfile.
COPY --chown=node:node packages/core/package.json /repo/packages/core/package.json
COPY --chown=node:node packages/automation-core/package.json /repo/packages/automation-core/package.json
COPY --chown=node:node services/control-plane/package.json services/control-plane/package-lock.json ./
# postinstall builds automation-core, whose source is intentionally in the next
# layer; prestart performs that same build before the service boots.
RUN test -f package-lock.json && npm ci --ignore-scripts
COPY --chown=node:node packages/core /repo/packages/core
COPY --chown=node:node packages/automation-core /repo/packages/automation-core
# automation-core's tsconfig compiles canonical sources from ../../src/automation.
COPY --chown=node:node src/automation /repo/src/automation
# Keep the local package linked to its source directory. Build and verify it now
# that its canonical source is present; prestart rebuilds it again on boot.
RUN rm -rf node_modules/@bivy/automation-core \
    && ln -s /repo/packages/automation-core node_modules/@bivy/automation-core \
    && npm run build:automation-core \
    && node --input-type=module -e \
      "import('@bivy/automation-core').then((m) => { if (typeof m.evaluateAutomation !== 'function') process.exit(1) })"
COPY --chown=node:node services/control-plane/ ./
# Bundle the built React client so the control plane serves it at the root.
COPY --chown=node:node --from=webbuild /repo/packages/web/dist ./public/react
# Pin V8's old-space ceiling below the container's docker-compose mem_limit
# (512m — see deploy/docker-compose.yml) instead of relying on Node's cgroup
# auto-detection, which isn't guaranteed across every Docker/cgroup version and
# only bounds the V8 heap anyway (RSS also carries connection buffers, the pg
# client, the Stripe SDK, etc. outside it). Left unpinned, growth can walk right
# up to the cgroup limit with no headroom for that non-heap RSS — and because
# docker-compose doesn't cap container swap either, the container doesn't get a
# fast OOM-kill + clean restart at that point, it drags the *host* into swap.
# 384m leaves ~128m of headroom under the 512m cap. If mem_limit changes, update
# this too.
ENV NODE_OPTIONS="--max-old-space-size=384"
EXPOSE 4400
CMD ["npm", "start"]
