# syntax=docker/dockerfile:1
# Versioned, credential-free runner image for the sub-10s ephemeral fast lane.
# Build context is the repository root. Enrollment, room/model/provider keys,
# repo selection, and session restore data are injected only when claimed.

FROM node:22-bookworm-slim AS build
WORKDIR /repo
# The monorepo root installs with pnpm; corepack ships with the node image and
# resolves the version pinned in package.json's `packageManager`. The tarball
# this stage produces is still an npm package — build-release.mjs generates its
# own package-lock.json — which is what `npm install -g` consumes below.
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/automation-core/package.json ./packages/automation-core/package.json
COPY packages/core/package.json ./packages/core/package.json
COPY packages/plugin-sdk/package.json ./packages/plugin-sdk/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/web/package.json ./packages/web/package.json
# Dependency resolution changes only with manifests/lockfiles. Keep source out of
# this layer so normal Core changes reuse it. Only the root package is installed:
# src/ imports no workspace package, and the image skips the web app, so the
# workspace's other dependencies would only make this layer slower to restore.
RUN pnpm install --frozen-lockfile --ignore-scripts --filter @bivy/bivy
COPY tsconfig.json ./
COPY packages/ ./packages/
COPY src/ ./src/
# src/apps/preview-stream.ts shares the relay's bounded HTTP stream adapter.
# Include its canonical source so the symlink also resolves inside this stage.
COPY services/relay/src/preview-stream.ts ./services/relay/src/preview-stream.ts
COPY bin/ ./bin/
COPY public/qr.js ./public/qr.js
COPY scripts/ ./scripts/
COPY README.md LICENSE ./
# This stage only type-checks and packs; install scripts were skipped above.
# The context has no .git, so the packed manifest's `commit` comes from this
# build-arg (the workflow passes the pushed SHA); it is empty for local builds.
ARG GITHUB_SHA=
RUN GITHUB_SHA="$GITHUB_SHA" node scripts/build-release.mjs --pack /out --without-web

# Agent SDK bridges at Bivy's pinned versions, installed by Bivy's own installer
# (with its security overrides). This stage reads only package.json and the
# installer, so ordinary commits reuse it.
FROM node:22-bookworm-slim AS bridges
WORKDIR /repo
COPY package.json ./
COPY src/agent-bridges.mjs ./src/agent-bridges.mjs
RUN node --input-type=module -e "const m = await import('/repo/src/agent-bridges.mjs'); \
      await m.installBridges(Object.values(m.AGENT_BRIDGES).flatMap((b) => b.packages), { dir: '/bridges', stdio: 'inherit' });" \
  && test -x /bridges/node_modules/.bin/pi

# The Bivy package, installed on a bare base. It changes with every commit, so
# it is installed here and linked into the image below: building it never
# needs the image's large layers (Chromium, agent CLIs, bridges) unpacked.
# The terminal addon is prebuilt, so no compiler toolchain is needed.
FROM node:22-bookworm-slim AS bivy
COPY --from=build /out/bivy-latest.tar.gz /tmp/bivy.tar.gz
RUN npm install -g /tmp/bivy.tar.gz \
  && rm /tmp/bivy.tar.gz \
  && rm -rf /root/.npm \
  && node -e "require('/usr/local/lib/node_modules/@bivy/bivy/node_modules/@lydell/node-pty')" \
  && mkdir /bivy-bin \
  && cp -P /usr/local/bin/bivy /bivy-bin/

FROM node:22-bookworm-slim
LABEL org.opencontainers.image.source="https://github.com/bivysh/bivy"
LABEL org.opencontainers.image.description="Credential-free prebuilt Bivy ephemeral runner"
# Changing OS_PATCH_EPOCH (CI passes the ISO week) re-runs this layer, so cached
# builds still pick up Debian security updates the base image hasn't shipped yet.
ARG OS_PATCH_EPOCH=
# Chromium lets agents check what they built (`bivy app shot` when the user
# allows it, `bivy widget shot`, review card pictures); a cloud computer has
# no browser of its own.
RUN echo "os patch epoch: ${OS_PATCH_EPOCH:-unset}" \
  && apt-get update -qq \
  && apt-get upgrade -y -qq \
  && apt-get install -y -qq --no-install-recommends ca-certificates curl git openssh-client tini \
     chromium fonts-liberation \
  && rm -rf /var/lib/apt/lists/*
# Layers run from least to most often changed, so an ordinary commit reuses
# (and does not re-upload) everything above the Bivy package at the end.
# `all` is the compatibility/auth image. Interactive sessions can use the much
# smaller `claude`, `codex`, or `pi` variants selected by the requested runtime,
# avoiding a cold pull of unrelated agent binaries.
ARG BIVY_RUNNER_AGENT=all
RUN case "$BIVY_RUNNER_AGENT" in \
      all) npm install -g @openai/codex@0.147.0 @anthropic-ai/claude-code@2.1.246 ;; \
      codex) npm install -g @openai/codex@0.147.0 ;; \
      claude) npm install -g @anthropic-ai/claude-code@2.1.246 ;; \
      pi) : ;; \
      *) echo "unsupported BIVY_RUNNER_AGENT=$BIVY_RUNNER_AGENT" >&2; exit 1 ;; \
    esac \
  && rm -rf /root/.npm \
  && { [ "$BIVY_RUNNER_AGENT" != all ] && [ "$BIVY_RUNNER_AGENT" != codex ] || command -v codex; } \
  && { [ "$BIVY_RUNNER_AGENT" != all ] && [ "$BIVY_RUNNER_AGENT" != claude ] || command -v claude; }
# Agent SDK bridges live outside the Bivy package and outside the node's state
# dir, so they are baked into the image once. Their CLIs (Pi's `pi`) are
# exposed from the bridge directory's bin rather than one symlink per agent.
ENV BIVY_BRIDGES_DIR=/usr/local/lib/bivy-bridges
ENV PATH="/usr/local/lib/bivy-bridges/node_modules/.bin:${PATH}"
COPY --link --from=bridges /bridges /usr/local/lib/bivy-bridges
RUN mkdir -p /etc/bivy /workspace \
  && chmod 700 /etc/bivy
# Last, and linked: an ordinary commit adds only this layer, and the layers
# above are reused from the registry without being downloaded or unpacked.
COPY --link --from=bivy /usr/local/lib/node_modules/@bivy /usr/local/lib/node_modules/@bivy
COPY --link --from=bivy /bivy-bin/ /usr/local/bin/
ENV BIVY_DATA_DIR=/etc/bivy
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bivy", "start"]
