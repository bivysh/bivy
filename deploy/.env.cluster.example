# Shared by every control-plane and relay server in a multi-host deployment.
# Copy to deploy/.env.cluster (chmod 600) or point BIVY_CLUSTER_ENV_FILE at an
# absolute secret-managed env file. Keep the ordered shard URL list identical on
# every control-plane replica.
NODE_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/bivy?sslmode=require
DATABASE_POOL_MAX=10
RELAY_SECRET=replace-with-one-long-random-shared-secret
PUBLIC_CONTROL_PLANE_URL=https://app.example.com
RELAY_PUBLIC_URL=wss://relay-0.example.com
RELAY_SHARD_URLS=wss://relay-0.example.com,wss://relay-1.example.com
# Prefer a private/internal load-balancer address for relay introspection.
CONTROL_PLANE_URL=http://control-plane.internal:4400
DISABLE_DEV_LOGIN=1
ENFORCE_ENTITLEMENTS=0

# Each relay host must override this with its stable shard identity. The id is
# diagnostic; placement is determined by the matching RELAY_SHARD_URLS hostname.
RELAY_SHARD_ID=relay-0

# Pin immutable images for production rather than using the compose defaults.
CONTROL_PLANE_IMAGE=ghcr.io/bivysh/bivy-control-plane:sha-REPLACE
RELAY_IMAGE=ghcr.io/bivysh/bivy-relay:sha-REPLACE

# Optional auth/push settings (must also be identical across CP replicas).
RESEND_API_KEY=
AUTH_EMAIL_FROM=Bivy <login@example.com>
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
