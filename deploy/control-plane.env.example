# Portable control-plane configuration: any container host, no Compose required.
# Image: ghcr.io/bivysh/bivy-control-plane:<release-or-full-commit-sha>
# This image includes the web app. Keep both Bivy images on the same release.
NODE_ENV=production
PORT=4400
DATABASE_URL=
# Generate with openssl rand -hex 32; use the SAME value on the relay.
RELAY_SECRET=
PUBLIC_CONTROL_PLANE_URL=https://app.example.com
# Set to your ingress proxy IPs/CIDRs (comma-separated), e.g. 10.20.0.0/24.
# Empty trusts no forwarded client IPs. Never trust arbitrary Internet peers.
TRUST_PROXY=
RELAY_PUBLIC_URL=wss://relay.example.com
DISABLE_DEV_LOGIN=1
# Generate a DIFFERENT secret with openssl rand -hex 32. Paste it into the
# browser's owner setup form once, then use your chosen password to sign in.
# Do not put this in an image, public URL, source control, or frontend variable.
SELF_HOST_SETUP_TOKEN=
# Optional local account identity; not proof that an external email is verified.
SELF_HOST_OWNER_EMAIL=owner@self-host.invalid
