# Kamal secrets for deploy.yml and deploy.relay.yml. No values live here: each
# comes from your environment, e.g. deploy/kamal/.env (git-ignored) loaded with
#   set -a; . deploy/kamal/.env; set +a
# See docs/self-host-kamal.md for generating them.

RELAY_SECRET=$BIVY_RELAY_SECRET
POSTGRES_PASSWORD=$BIVY_POSTGRES_PASSWORD
# The Postgres accessory is `bivy-postgres` on the kamal network.
DATABASE_URL=postgres://bivy:${BIVY_POSTGRES_PASSWORD}@bivy-postgres:5432/bivy_control_plane

RESEND_API_KEY=$RESEND_API_KEY
AUTH_EMAIL_FROM=$AUTH_EMAIL_FROM
GITHUB_OAUTH_CLIENT_ID=$GITHUB_OAUTH_CLIENT_ID
GITHUB_OAUTH_CLIENT_SECRET=$GITHUB_OAUTH_CLIENT_SECRET
WEB_PUSH_VAPID_PUBLIC_KEY=$WEB_PUSH_VAPID_PUBLIC_KEY
WEB_PUSH_VAPID_PRIVATE_KEY=$WEB_PUSH_VAPID_PRIVATE_KEY
HOSTED_CREDENTIAL_KEY=$HOSTED_CREDENTIAL_KEY
