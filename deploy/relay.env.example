# Portable relay configuration: any long-running WebSocket-capable container host.
# Image: ghcr.io/bivysh/bivy-relay:<release-or-full-commit-sha>
NODE_ENV=production
PORT=4500
# The SAME random secret configured on the control plane.
RELAY_SECRET=
# The relay must reach this URL. Use a stable internal address if available;
# otherwise the public HTTPS control-plane URL works.
CONTROL_PLANE_URL=https://app.example.com
