# Self-hosted Bivy configuration. deploy/self-host.sh creates this file with
# generated secrets; use this example only when configuring Compose manually.
NODE_ENV=production

PUBLIC_CONTROL_PLANE_URL=https://app.example.com
RELAY_PUBLIC_URL=wss://relay.example.com
DISABLE_DEV_LOGIN=1

# Generate with: openssl rand -base64 48
RELAY_SECRET=change-me-to-a-long-random-string

# Bundled Postgres. Generate the password with: openssl rand -base64 32
POSTGRES_DB=bivy_control_plane
POSTGRES_USER=bivy
POSTGRES_PASSWORD=change-me-to-a-long-random-db-password

# Configure email magic links or GitHub OAuth before starting the stack.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Bivy <login@app.example.com>
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional web push notifications. Generate with:
# npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@app.example.com

# To use managed Postgres, set DATABASE_URL and layer
# docker-compose.hosted-db.yml over docker-compose.yml.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
