# Copy to .env and fill in.
#
# Set NODE_ENV=production for any internet-facing deployment. In production the
# control plane and relay refuse to boot with insecure defaults (missing
# DATABASE_URL, default/empty RELAY_SECRET, or STRIPE_SECRET_KEY without a
# webhook secret). Leave it unset for local/dev convenience.
NODE_ENV=production

# Keep RELAY_SECRET long and private — it is the shared secret the relay uses to
# introspect tokens against the control plane. Generate with: openssl rand -hex 32
RELAY_SECRET=change-me-to-a-long-random-string

# The PUBLIC wss URL of the relay (what phones connect to). Must match your
# Caddyfile relay domain.
RELAY_PUBLIC_URL=wss://relay.bivy.sh

# Optional relay sharding (docs/scaling.md). Leave UNSET for a single relay (the
# default). To scale routing past one CPU core, run multiple relay processes and
# list their public wss URLs here, comma-separated. The control plane hashes each
# node to one shard and routes the node + all its clients there. Example:
#   RELAY_SHARD_URLS=wss://relay-0.bivy.sh,wss://relay-1.bivy.sh
# RELAY_SHARD_URLS=

# Keep 0 for staging until Stripe upgrades are wired. Set 1 for live beta once
# paid plans update relayEnabled entitlements.
ENFORCE_ENTITLEMENTS=0
RELAY_MAX_FRAME_BYTES=1048576
RELAY_MAX_MESSAGES_PER_MINUTE=120
# Max concurrent relay connections per source IP, and how long (ms) a connection
# can go without responding to a heartbeat ping before it is dropped.
RELAY_MAX_CONNECTIONS_PER_IP=50
RELAY_IDLE_TIMEOUT_MS=120000

# Public control-plane URL, used when generating magic-login links.
PUBLIC_CONTROL_PLANE_URL=https://app.bivy.sh

# For staging you may leave dev login enabled. For live beta set this to 1 and
# configure RESEND_API_KEY + AUTH_EMAIL_FROM.
DISABLE_DEV_LOGIN=0
RESEND_API_KEY=
AUTH_EMAIL_FROM=Bivy <login@bivy.sh>

# Billing (STRIPE_* / BILLING_*) is intentionally absent: it exists to run a paid
# hosting business, and a stack you host for yourself has no one to charge. Leave
# ENFORCE_ENTITLEMENTS unset and every feature is on for every account. The
# variables are still read if you set them — see "Billing (hosted only)" in
# docs/configuration.md — but you should not need to think about them.

# Web Push (phone/PWA notifications when an agent needs you). Push is DISABLED
# until both VAPID keys are set — without them the control plane silently serves
# no notifications. Generate a keypair once with: npx web-push generate-vapid-keys
# With ENFORCE_ENTITLEMENTS=0 (the self-host default) push is available to every
# account; with =1 it is gated to paid (Individual/Team) plans.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@bivy.sh

# GitHub OAuth App credentials — enables "Sign in with GitHub" on the web client,
# mobile app, and CLI. Create an OAuth App with callback
# https://app.bivy.sh/auth/github/callback (see docs/github-oauth-setup.md).
# The control plane reads these names at runtime. NOTE: scripts/sync-github-env.sh
# pushes them to GitHub Actions secrets named BIVY_GITHUB_OAUTH_CLIENT_ID /
# BIVY_GITHUB_OAUTH_CLIENT_SECRET, because GitHub reserves the GITHUB_ prefix for
# secret/variable names.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Database ---------------------------------------------------------------
#
# TWO options; pick one.
#
# Option A (default): the bundled `postgres` container from docker-compose.yml.
# The control plane's DATABASE_URL is BUILT from the three POSTGRES_* vars below
# at container-start time, so set those and DO NOT set DATABASE_URL here.
#
# Generate a long password, e.g. `openssl rand -base64 32`.
#
# POSTGRES_USER/POSTGRES_DB only take effect on first init of an empty
# postgres_data volume. If you change them on a box that already has data, reset
# the volume once (Deploy staging workflow, reset_volumes=true) so postgres
# re-initializes — otherwise the control plane crash-loops on a missing role.
POSTGRES_DB=bivy_control_plane
POSTGRES_USER=bivy
POSTGRES_PASSWORD=change-me-to-a-long-random-db-password

# Option B: a MANAGED/HOSTED Postgres (DigitalOcean, Render, Neon, Supabase,
# Amazon RDS, ...). Layer deploy/docker-compose.hosted-db.yml over the base
# compose file (see the header of that file) and set DATABASE_URL to your
# provider's connection string. Hosted providers require TLS, so keep the
# sslmode parameter they give you. The POSTGRES_* vars above are then unused —
# leave them as-is (deleting them just prints a harmless "variable is not set"
# warning from the base compose file).
#
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# Control-plane Postgres connection pool size (per instance). Default 10. Raise
# it if introspection queries queue during reconnect storms (e.g. after a relay
# restart). When running multiple control-plane instances, keep
# instances x DATABASE_POOL_MAX under Postgres max_connections, or use PgBouncer
# (docs/scaling.md).
# DATABASE_POOL_MAX=10
