# Example Caddyfile for a SHARDED relay fleet (docs/scaling.md).
# Pair with deploy/docker-compose.shards.example.yml and set in .env:
#   RELAY_SHARD_URLS=wss://relay-0.bivy.sh,wss://relay-1.bivy.sh
#
# Each public relay hostname maps to one relay container. The control plane hands
# each node/client the hostname for its shard; Caddy just terminates TLS and
# proxies each hostname to the matching container.

app.bivy.sh {
	# Keep internal metrics/readiness endpoints off the public internet.
	# /healthz (liveness) stays reachable for uptime checks. `handle` blocks are
	# mutually exclusive and evaluated in source order, so the 403 reliably wins
	# over the proxy (a bare `respond` + `reverse_proxy` would not — Caddy orders
	# reverse_proxy ahead of respond).
	@internal path /metrics* /readyz
	handle @internal {
		respond 403
	}
	handle {
		reverse_proxy control-plane:4400
	}
}

relay-0.bivy.sh {
	@internal path /metrics* /readyz
	handle @internal {
		respond 403
	}
	handle {
		reverse_proxy relay:4500
	}
}

relay-1.bivy.sh {
	@internal path /metrics* /readyz
	handle @internal {
		respond 403
	}
	handle {
		reverse_proxy relay-1:4500
	}
}
