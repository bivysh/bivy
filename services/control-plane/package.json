{
  "name": "bivy-control-plane",
  "version": "0.22.6",
  "private": true,
  "type": "module",
  "description": "Self-hostable Bivy control plane: accounts, node registry, session index, and automation coordination.",
  "scripts": {
    "build:automation-core": "tsc -p ../../packages/automation-core/tsconfig.json",
    "postinstall": "npm run build:automation-core",
    "predev": "npm run build:automation-core",
    "build": "npm run build:automation-core && node scripts/build.mjs",
    "prestart": "npm run build",
    "pretypecheck": "npm run build:automation-core",
    "dev": "tsx src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "pretest:unit": "npm run build:automation-core",
    "test:unit": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@bivy/automation-core": "file:../../packages/automation-core",
    "@bivy/core": "file:../../packages/core",
    "@sentry/node": "^10.78.0",
    "@types/web-push": "^3.6.4",
    "cron-parser": "^5.10.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "prom-client": "^15.1.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
