{
  "name": "bivy-relay",
  "version": "0.17.1",
  "private": true,
  "type": "module",
  "description": "Self-hostable/Bivy Cloud relay: routes opaque, E2E-encrypted frames between clients and nodes through NAT. Cannot read session content.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --log-level=warning --outfile=dist/index.js",
    "prestart": "npm run build",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:process": "tsx test/service-process.test.ts",
    "test:e2e": "tsx test/e2e.ts",
    "test:solo": "tsx test/solo-admission.test.ts",
    "test:backpressure": "tsx test/backpressure.test.ts",
    "test:bundle": "tsx test/bundle.test.ts",
    "test:unit": "npm run test:process && npm run test:bundle && npm run test:backpressure && npm run test:e2e && npm run test:solo"
  },
  "dependencies": {
    "@sentry/node": "^10.75.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
