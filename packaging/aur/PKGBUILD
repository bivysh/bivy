# Maintainer: Petter André Sjulstad
# Built from the GitHub release archives of bivysh/bivy, which bundle their own
# Node runtime. scripts/aur-bump.mjs updates pkgver and the sha256sums for a new
# release; see packaging/aur/README.md.

pkgname=bivy-bin
pkgver=0.21.2
pkgrel=1
pkgdesc='Run coding agents on machines you own and drive them from your phone'
arch=('x86_64' 'aarch64')
url='https://github.com/bivysh/bivy'
license=('AGPL-3.0-only')
depends=('git')
optdepends=(
  'tailscale: reach this machine from your phone with no server in between (bivy tailscale)'
)
provides=('bivy')
conflicts=('bivy')
options=('!strip')
source_x86_64=("https://github.com/bivysh/bivy/releases/download/v${pkgver}/bivy-${pkgver}-linux-x64.tar.gz")
source_aarch64=("https://github.com/bivysh/bivy/releases/download/v${pkgver}/bivy-${pkgver}-linux-arm64.tar.gz")
# Set by scripts/aur-bump.mjs from the release's SHA256SUMS.
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  local target=linux-x64
  [ "$CARCH" = aarch64 ] && target=linux-arm64
  install -d "${pkgdir}/usr/lib" "${pkgdir}/usr/bin"
  cp -a "${srcdir}/bivy-${pkgver}-${target}" "${pkgdir}/usr/lib/bivy"
  ln -s /usr/lib/bivy/bin/bivy "${pkgdir}/usr/bin/bivy"

  # Tells `bivy update` and the app's Update button that pacman owns this copy.
  printf '{"manager":"pacman","update":"yay -Syu bivy-bin (or your AUR helper)"}\n' > "${pkgdir}/usr/lib/bivy/app/.bivy-install.json"

  install -Dm644 "${pkgdir}/usr/lib/bivy/app/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
