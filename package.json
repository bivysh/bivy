{
  "name": "@bivy/bivy",
  "version": "0.16.9",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Run coding agents on machines you own. Open-source, self-hostable agent workspace.",
  "keywords": [
    "ai-agent",
    "coding-agent",
    "claude-code",
    "codex",
    "self-hosted",
    "developer-tools"
  ],
  "homepage": "https://bivy.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bivysh/bivy.git"
  },
  "bugs": {
    "url": "https://github.com/bivysh/bivy/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "bivy": "bin/bivy.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "node scripts/disable-git-hooks.mjs",
    "postinstall": "node bin/patch-pi-dependencies.mjs",
    "prepublishOnly": "node -e \"console.error('\\nRefusing to publish from the repo root — this would ship the whole monorepo (src/, services/, tests, and any local .env).\\nUse: pnpm run publish:npm  (scripts/build-release.mjs publishes a curated staging dir). See docs/releasing.md.\\n'); process.exit(1)\"",
    "setup": "node bin/bivy.mjs setup",
    "bivy": "node bin/bivy.mjs",
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "agent-service": "tsx src/runtime/agent-service-bin.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @bivy/plugin-sdk run typecheck && pnpm --filter @bivy/automation-core run typecheck",
    "lint": "eslint .",
    "build:web": "pnpm --filter @bivy/web run build",
    "dev:web": "pnpm --filter @bivy/web run dev",
    "test:core": "pnpm --filter @bivy/core run test",
    "typecheck:web": "pnpm --filter @bivy/core run typecheck && pnpm --filter @bivy/web run typecheck",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:pins": "node scripts/check-security-pins.mjs",
    "check:secrets": "node scripts/secret-scan.mjs",
    "check:boundaries": "node scripts/check-module-boundaries.mjs --enforce",
    "check:routes": "node scripts/check-server-routes.mjs",
    "check:design": "node scripts/check-design-tokens.mjs",
    "gen:agent-manifest": "tsx scripts/generate-agent-manifest.ts",
    "gen:fork-matrix": "tsx scripts/gen-fork-matrix.ts",
    "certification:generate": "node scripts/certification.mjs --generate",
    "certification:check": "node scripts/certification.mjs --check",
    "certification:latest": "node scripts/certification.mjs --latest",
    "certification:live": "node scripts/certification.mjs --live",
    "check:links": "node scripts/check-links.mjs",
    "release:version": "node scripts/set-release-version.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:release-smoke": "node scripts/smoke-release.mjs",
    "publish:npm": "node scripts/build-release.mjs --publish",
    "publish:npm:dry": "node scripts/build-release.mjs --publish --dry-run",
    "test:remote": "tsx test/remote-e2e.ts",
    "test:unit": "node scripts/run-tests.mjs",
    "test:browser": "playwright test",
    "agent": "tsx src/native-pi.ts",
    "agent:login": "tsx src/native-pi.ts /login",
    "agent:config": "tsx src/native-pi.ts config",
    "agent:list": "tsx src/native-pi.ts list",
    "agent:update": "tsx src/native-pi.ts update",
    "pi": "tsx src/native-pi.ts",
    "pi:login": "tsx src/native-pi.ts /login",
    "pi:config": "tsx src/native-pi.ts config",
    "pi:list": "tsx src/native-pi.ts list",
    "pi:update": "tsx src/native-pi.ts update",
    "relay:setup": "node bin/bivy.mjs relay:setup",
    "audit:prod": "node scripts/audit-prod.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "brace-expansion": "5.0.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "semver": "^7.7.2",
    "typebox": "^1.3.19",
    "undici": "8.10.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.258",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "node-pty": "^1.1.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@earendil-works/pi-coding-agent": {
      "brace-expansion": "5.0.9",
      "undici": "8.10.0"
    },
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "heroicons": "^2.2.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
