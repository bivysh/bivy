{
  "name": "@bivy/bivy",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "description": "Run coding agents on machines you own. Source-available, self-hostable agent workspace.",
  "homepage": "https://bivy.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bivysh/bivy.git"
  },
  "bugs": {
    "url": "https://github.com/bivysh/bivy/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "bivy": "bin/bivy.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "node scripts/disable-git-hooks.mjs",
    "postinstall": "node bin/patch-pi-dependencies.mjs",
    "prepublishOnly": "node -e \"console.error('\\nRefusing to publish from the repo root — this would ship the whole monorepo (src/, services/, tests, and any local .env).\\nUse: npm run publish:npm  (scripts/build-release.mjs publishes a curated staging dir). See docs/releasing.md.\\n'); process.exit(1)\"",
    "setup": "node bin/bivy.mjs setup",
    "bivy": "node bin/bivy.mjs",
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "agent-service": "tsx src/runtime/agent-service-bin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:web": "npm run build -w @bivy/web",
    "dev:web": "npm run dev -w @bivy/web",
    "test:core": "npm run test -w @bivy/core",
    "typecheck:web": "npm run typecheck -w @bivy/core && npm run typecheck -w @bivy/web",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:secrets": "node scripts/secret-scan.mjs",
    "gen:agent-manifest": "tsx scripts/generate-agent-manifest.ts",
    "check:links": "node scripts/check-links.mjs",
    "build:release": "node scripts/build-release.mjs",
    "publish:npm": "node scripts/build-release.mjs --publish",
    "publish:npm:dry": "node scripts/build-release.mjs --publish --dry-run",
    "test:remote": "tsx test/remote-e2e.ts",
    "test:unit": "node scripts/run-tests.mjs",
    "test:browser": "playwright test",
    "agent": "tsx src/native-pi.ts",
    "agent:login": "tsx src/native-pi.ts /login",
    "agent:config": "tsx src/native-pi.ts config",
    "agent:list": "tsx src/native-pi.ts list",
    "agent:update": "tsx src/native-pi.ts update",
    "pi": "tsx src/native-pi.ts",
    "pi:login": "tsx src/native-pi.ts /login",
    "pi:config": "tsx src/native-pi.ts config",
    "pi:list": "tsx src/native-pi.ts list",
    "pi:update": "tsx src/native-pi.ts update",
    "relay:setup": "node bin/bivy.mjs relay:setup"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.199",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "brace-expansion": "5.0.8",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "typebox": "^1.3.6",
    "ws": "^8.21.1"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@earendil-works/pi-coding-agent": {
      "brace-expansion": "5.0.8"
    },
    "brace-expansion": "5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "heroicons": "^2.2.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
