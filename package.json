{
  "name": "@bivy/bivy",
  "version": "0.21.13",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Run coding agents on machines you own. Open-source, self-hostable agent workspace.",
  "keywords": [
    "ai-agent",
    "coding-agent",
    "claude-code",
    "codex",
    "self-hosted",
    "developer-tools"
  ],
  "homepage": "https://bivy.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bivysh/bivy.git"
  },
  "bugs": {
    "url": "https://github.com/bivysh/bivy/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "bivy": "bin/bivy.mjs"
  },
  "scripts": {
    "prepare": "node scripts/disable-git-hooks.mjs",
    "setup": "node bin/bivy.mjs setup",
    "bivy": "node bin/bivy.mjs",
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "agent-service": "tsx src/runtime/agent-service-bin.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && pnpm --filter @bivy/plugin-sdk run typecheck && pnpm --filter @bivy/automation-core run typecheck",
    "lint": "eslint . --quiet --cache --cache-location node_modules/.cache/eslint/",
    "lint:all": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "build:web": "pnpm --filter @bivy/web run build",
    "dev:web": "pnpm --filter @bivy/web run dev",
    "test:core": "pnpm --filter @bivy/core run test",
    "typecheck:web": "pnpm --filter @bivy/core run typecheck && pnpm --filter @bivy/web run typecheck",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:pins": "node scripts/check-security-pins.mjs",
    "check:secrets": "node scripts/secret-scan.mjs",
    "check:boundaries": "node scripts/check-module-boundaries.mjs --enforce",
    "check:routes": "node scripts/check-server-routes.mjs",
    "check:design": "node scripts/check-design-tokens.mjs",
    "check:cli": "node scripts/check-cli.mjs",
    "gen:agent-manifest": "tsx scripts/generate-agent-manifest.ts",
    "gen:fork-matrix": "tsx scripts/gen-fork-matrix.ts",
    "certification:generate": "node scripts/certification.mjs --generate",
    "certification:check": "node scripts/certification.mjs --check",
    "certification:latest": "node scripts/certification.mjs --latest",
    "certification:live": "node scripts/certification.mjs --live",
    "eval:agent-ux": "tsx scripts/agent-ux-eval.ts",
    "check:links": "node scripts/check-links.mjs",
    "release": "node scripts/release.mjs",
    "release:version": "node scripts/set-release-version.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:remote": "tsx test/remote-e2e.ts",
    "test:unit": "node scripts/run-tests.mjs",
    "test:browser": "playwright test",
    "agent": "tsx src/native-pi.ts",
    "agent:login": "tsx src/native-pi.ts /login",
    "agent:config": "tsx src/native-pi.ts config",
    "agent:list": "tsx src/native-pi.ts list",
    "agent:update": "tsx src/native-pi.ts update",
    "pi": "tsx src/native-pi.ts",
    "pi:login": "tsx src/native-pi.ts /login",
    "pi:config": "tsx src/native-pi.ts config",
    "pi:list": "tsx src/native-pi.ts list",
    "pi:update": "tsx src/native-pi.ts update",
    "relay:setup": "node bin/bivy.mjs relay:setup",
    "audit:prod": "node scripts/audit-prod.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@novnc/novnc": "1.7.0",
    "brace-expansion": "5.0.12",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "semver": "^7.7.2",
    "typebox": "^1.4.3",
    "undici": "8.12.3",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.311",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "hono": "4.13.14",
    "qs": "6.16.0",
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@earendil-works/pi-coding-agent": {
      "brace-expansion": "5.0.12",
      "undici": "8.12.3"
    },
    "brace-expansion": "5.0.12",
    "nanoid": "3.3.18",
    "lodash-es": "4.18.1",
    "undici": "8.12.3",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@earendil-works/pi-telemetry": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.2",
    "axe-core": "^4.14.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "heroicons": "^2.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
